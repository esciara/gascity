vars: {
  d2-config: {
    sketch: true
  }
}

direction: right

browser: Browser {
  shape: person
  style.fill: "#a5d8ff"
  style.stroke: "#1e1e1e"
}
cdn: CDN {
  style.fill: "#fff3bf"
  style.stroke: "#1e1e1e"
}
lb: Load Balancer {
  style.fill: "#ffd8a8"
  style.stroke: "#1e1e1e"
}

apps: App Servers {
  style.fill: "#e5dbff"
  style.stroke: "#8b5cf6"
  app1: App Server 1 {
    style.fill: "#d0bfff"
    style.stroke: "#1e1e1e"
  }
  app2: App Server 2 {
    style.fill: "#d0bfff"
    style.stroke: "#1e1e1e"
  }
}

data: Data Layer {
  style.fill: "#d3f9d8"
  style.stroke: "#22c55e"
  db: Primary DB {
    shape: cylinder
    style.fill: "#b2f2bb"
    style.stroke: "#1e1e1e"
  }
  replica: Read Replica {
    shape: cylinder
    style.fill: "#c3fae8"
    style.stroke: "#1e1e1e"
  }
  cache: Redis {
    shape: cylinder
    style.fill: "#ffc9c9"
    style.stroke: "#1e1e1e"
  }

  db -> replica: replication {
    style.stroke-dash: 4
    style.stroke: "#22c55e"
  }
}

browser -> cdn
cdn -> lb
lb -> apps.app1
lb -> apps.app2

apps.app1 -> data.db: writes
apps.app2 -> data.db: writes
apps.app1 -> data.replica: reads
apps.app2 -> data.replica: reads
apps.app1 -> data.cache
apps.app2 -> data.cache
