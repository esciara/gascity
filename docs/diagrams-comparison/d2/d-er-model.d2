User: {
  shape: sql_table
  id: int {constraint: primary_key}
  email: string
  name: string
  created_at: datetime
}

Order: {
  shape: sql_table
  id: int {constraint: primary_key}
  user_id: int {constraint: foreign_key}
  total: decimal
  status: string
  placed_at: datetime
}

Product: {
  shape: sql_table
  id: int {constraint: primary_key}
  sku: string
  name: string
  price: decimal
}

User.id -> Order.user_id: places (1..N)
Order -> Product: contains (N..M)
