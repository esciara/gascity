shape: sequence_diagram

user: User {
  style.fill: "#a5d8ff"
  style.stroke: "#4a9eed"
}
client: Client App {
  style.fill: "#d0bfff"
  style.stroke: "#8b5cf6"
}
auth: Auth Server {
  style.fill: "#ffd8a8"
  style.stroke: "#f59e0b"
}
resource: Resource Server {
  style.fill: "#b2f2bb"
  style.stroke: "#22c55e"
}

user -> client: 1. Click "Log in"
client -> auth: 2. Redirect to /authorize
auth -> user: 3. Show login page
user -> auth: 4. Submit credentials + consent
auth -> client: 5. Redirect with auth code
client -> auth: 6. POST /token (code + client secret)
auth -> client: 7. Access token (+ refresh token)
client -> resource: 8. GET /api with access token
resource -> client: 9. Return protected resource
